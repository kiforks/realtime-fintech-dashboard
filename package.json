{
	"name": "realtime-fintech-dashboard",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.17.0",
	"engines": {
		"node": "^24.15.0"
	},
	"scripts": {
		"prepare": "husky",
		"build:wasm": "node scripts/with-rust.mjs wasm-pack build wasm --target web --release --no-pack && node -e \"require('node:fs').rmSync('wasm/pkg/market_generator_bg.wasm.d.ts', { force: true })\"",
		"prestart": "npm run build:wasm",
		"start": "ng serve",
		"prebuild": "npm run build:wasm",
		"build": "ng build",
		"pretest": "npm run build:wasm",
		"test": "ng test --no-watch",
		"test:wasm": "node scripts/with-rust.mjs cargo test --manifest-path wasm/Cargo.toml",
		"prelint": "npm run build:wasm",
		"lint": "tsc -p tsconfig.worker.json --noEmit && eslint . && stylelint \"src/**/*.scss\" && prettier --check .",
		"lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix && prettier --write .",
		"lint:wasm": "node scripts/with-rust.mjs cargo fmt --manifest-path wasm/Cargo.toml --check && node scripts/with-rust.mjs cargo clippy --manifest-path wasm/Cargo.toml --all-targets -- -D warnings"
	},
	"dependencies": {
		"@angular/common": "22.2.3",
		"@angular/compiler": "22.2.3",
		"@angular/core": "22.2.3",
		"@angular/forms": "22.2.3",
		"@angular/localize": "22.2.3",
		"@angular/platform-browser": "22.2.3",
		"@angular/router": "22.2.3",
		"rxjs": "7.8.2",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@angular/build": "22.2.3",
		"@angular/cdk": "22.2.3",
		"@angular/cli": "22.2.3",
		"@angular/compiler-cli": "22.2.3",
		"@kiforks/eslint-config": "1.5.0",
		"@kiforks/prettier-config": "2.0.2",
		"@kiforks/stylelint-config": "1.0.2",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "9.39.5",
		"happy-dom": "21.0.3",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"stylelint": "16.26.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vitest": "5.0.5",
		"wasm-pack": "0.15.0"
	},
	"allowScripts": {
		"wasm-pack@0.15.0": true
	}
}
